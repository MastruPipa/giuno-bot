{
  "name": "giuno-bot",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test test/*.test.js",
    "eval": "node scripts/eval-run.js",
    "eval:import": "node scripts/eval-import-thread.js",
    "check:conflicts": "bash scripts/check-conflicts.sh",
    "check:deploy": "bash scripts/post-deploy-check.sh",
    "check:ecosystem": "bash scripts/check-ecosystem.sh",
    "resolve:slack-conflict": "bash scripts/resolve-slackservice-conflict.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@google/generative-ai": "^0.24.1",
    "@slack/bolt": "^5.1.0",
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^16.0.0",
    "googleapis": "^178.1.1",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
